{
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/t/:code", "destination": "/tickets.html" }
  ],
  "functions": {
    "api/tickets/[code].js": {
      "includeFiles": "api/_lib/assets/**"
    },
    "api/orders.js": {
      "includeFiles": "api/_assets/email/**"
    },
    "api/orders/[id].js": {
      "includeFiles": [
        "api/_assets/email/**",
        "api/_lib/assets/**"
      ]
    }
  }
}